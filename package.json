{
  "name": "@strakzat/orbit",
  "version": "3.2.0",
  "description": "Orbit — client-facing annotation & feedback engine voor alle projecten",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    }
  },
  "bin": {
    "orbit-scan": "./bin/orbit-scan.js",
    "orbit-init": "./bin/orbit-init.js",
    "orbit-feedback": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:tokens",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^18",
    "tsup": "^8",
    "typescript": "~5.6",
    "vitest": "^2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strakzat/orbit.git"
  }
}
